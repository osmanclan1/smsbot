# Copy to .env at repo root. Used by deploy/deploy-pilot.sh for SAM.

# Required for pilot deploy
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_PUBLIC_KEY=

# Optional: protect POST /api/trigger (Bearer token)
TRIGGER_API_KEY=

# AWS: use either SSO profile (recommended) or static keys + session token
AWS_PROFILE=
AWS_REGION=us-east-1

# Optional: local SFTP → S3 bridge (scripts/pilot-local-sftp-bridge.sh)
# If unset, bucket is read from CloudFormation output PilotInboundBucketName on smsbot-pilot-v1-stack.
# PILOT_INBOUND_BUCKET=
# PILOT_STACK_NAME=smsbot-pilot-v1-stack
# PILOT_SFTP_LOCAL_DIR=/Users/you/pilot-sftp-incoming
